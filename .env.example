# PasseFiltre : configuration (tout est facultatif). Copiez ce fichier en .env pour l'adapter.
# `npm run setup` le fait pour vous. Les variables d'environnement réelles restent prioritaires.

# --- Ports ---------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Adresse de l'API vue par le navigateur (par défaut http://localhost:BACKEND_PORT).
# À changer si vous accédez à PasseFiltre depuis une autre machine.
# Origine seule, SANS « /api » (le frontend ajoute lui-même /api/...). Derrière un reverse
# proxy qui sert l'interface et /api/ sur le même domaine : NEXT_PUBLIC_API_URL=https://ce-domaine
NEXT_PUBLIC_API_URL=
# Origines autorisées à appeler l'API (par défaut l'interface sur FRONTEND_PORT).
CORS_ORIGINS=

# --- LLM par défaut (facultatif) -------------------------------------------
# Si LLM_API_KEY est renseignée, l'agent IA fonctionne sans saisir de clé dans l'interface.
# N'importe quelle API compatible OpenAI : OpenAI, Mistral, Groq, OpenRouter, Ollama, Paradigm…
# (une URL définie ici est de confiance : un Ollama local fonctionne sans ALLOW_LOCAL_LLM)
LLM_API_KEY=
# URL de base, celle qui précède /chat/completions (vide = OpenAI).
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Sécurité ---------------------------------------------------------------
# Jeton d'accès à l'API. Vide = pas de jeton (usage local sur cette machine).
# OBLIGATOIRE (32 caractères ou plus) dès que PasseFiltre est accessible depuis le réseau :
# l'API refuse alors de démarrer sans lui.
PASSEFILTRE_TOKEN=
# Noms d'hôte acceptés par l'API en plus de localhost/127.0.0.1 (protection contre le DNS rebinding).
ALLOWED_HOSTS=
# Adresses d'écoute. 127.0.0.1 = cette machine uniquement (recommandé).
BACKEND_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1
# Docker : interface sur laquelle les ports sont publiés.
BIND_ADDRESS=127.0.0.1
# 1 = autorise une URL de LLM locale ou privée saisie dans l'interface (Ollama, vLLM du réseau…).
ALLOW_LOCAL_LLM=0
# Nombre maximum de tâches simultanées (extractions LinkedIn + agent IA).
MAX_JOBS=2

# --- CAPTCHA LinkedIn résolu à distance (image Docker) -----------------------
# Si LinkedIn affiche un CAPTCHA, l'extraction rouvre le navigateur sur un écran virtuel privé (Xvfb)
# et l'interface propose « Résoudre le CAPTCHA » (noVNC, via l'API en HTTPS/WSS, aucun port VNC publié).
# 0 = désactivé (le CAPTCHA arrête l'extraction, comme avant).
INTERACTIVE_CAPTCHA=1
# Secondes laissées pour résoudre un CAPTCHA une fois affiché (minimum 60).
CAPTCHA_TIMEOUT=300
# Écrans virtuels simultanés (chacun = un Chromium visible, ~400 Mo) : 1 conseillé sur Raspberry Pi.
MAX_CAPTCHA_SESSIONS=1
# Plafond mémoire du conteneur API (docker compose).
API_MEM_LIMIT=3g

# --- Mise en réseau (HTTPS) --------------------------------------------------
# `docker compose --profile https up -d` : Caddy sert l'interface et l'API en HTTPS sur SITE_ADDRESS.
# Remplir TOUTES ces lignes (même adresse partout), puis reconstruire : docker compose --profile https up -d --build
#   SITE_ADDRESS=passefiltre.lan            (nom de domaine, nom local ou IP, sans https://)
#   NEXT_PUBLIC_API_URL=https://passefiltre.lan
#   CORS_ORIGINS=https://passefiltre.lan
#   PASSEFILTRE_TOKEN=<32 caractères aléatoires ou plus>
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
SITE_ADDRESS=
# Interface sur laquelle Caddy écoute (0.0.0.0 = tout le réseau).
HTTPS_BIND=0.0.0.0
# Journal d'audit dans un fichier en plus de la sortie standard (facultatif).
AUDIT_LOG_FILE=

# --- Diagnostic --------------------------------------------------------------
# 1 = enregistre le HTML des pages LinkedIn dans debug/ (données personnelles, ignoré par git).
DEBUG_SCRAPE=0
