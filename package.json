{
  "name": "cv-ats-generator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy:start": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -Action start -Mode dev",
    "deploy:restart": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -Action restart -Mode dev",
    "deploy:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -Action stop -Mode dev",
    "deploy:status": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -Action status -Mode dev",
    "deploy:logs": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -Action logs -Mode dev",
    "deploy:prod:start": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -Action start -Mode prod -Build",
    "deploy:prod:restart": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -Action restart -Mode prod -Build"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "lucide-react": "^0.510.0",
    "next": "^15.3.2",
    "next-themes": "^0.4.6",
    "puppeteer-core": "^24.42.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
